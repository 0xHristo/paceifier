{
	"name": "paceifier",
	"version": "0.1.0-alpha.2",
	"description": "Run long sequential work in short slices so it never blocks the event loop",
	"author": "hristoht",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xHristo/paceifier.git"
	},
	"homepage": "https://github.com/0xHristo/paceifier#readme",
	"bugs": "https://github.com/0xHristo/paceifier/issues",
	"main": "index.js",
	"type": "commonjs",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./register": {
			"types": "./register.d.ts",
			"default": "./register.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"register.js",
		"register.d.ts",
		"llms.txt",
		"lib"
	],
	"scripts": {
		"test": "node --test --test-concurrency=1 'test/*.test.js'",
		"bench": "node --expose-gc bench/overhead.js",
		"bench:compare": "node bench/compare.js",
		"test:update": "UPDATE_SNAPSHOTS=1 node --test --test-concurrency=1 'test/*.test.js'"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"event-loop",
		"event-loop-lag",
		"yield",
		"chunking",
		"cpu-bound",
		"express",
		"non-blocking",
		"blocking",
		"cpu",
		"responsiveness",
		"setImmediate",
		"async",
		"iterator",
		"map",
		"forEach",
		"deno",
		"bun"
	],
	"license": "Apache-2.0"
}
